  <diagram id="Nx1NGrcVXgo-P3kqYqbt" name="kelola pengguna">
    <mxGraphModel dx="860" dy="479" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Admin\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nAdmin-&gt;&gt;FlutterUI: Buka Halaman Kelola Pengguna\nFlutterUI-&gt;&gt;LaravelAPI: GET /admin/users (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil semua pengguna\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar pengguna\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {users}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Admin: Tampilkan Daftar Pengguna\n\nalt Tambah Pengguna\n    Admin-&gt;&gt;FlutterUI: Klik Tambah Pengguna\n    Admin-&gt;&gt;FlutterUI: Input Data Pengguna\n    Admin-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: POST /admin/users\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan pengguna baru\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Pengguna tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Pengguna Ditambahkan\nend\n\nalt Edit Pengguna\n    Admin-&gt;&gt;FlutterUI: Pilih Pengguna\n    Admin-&gt;&gt;FlutterUI: Ubah Data Pengguna\n    Admin-&gt;&gt;FlutterUI: Klik Update\n\n    FlutterUI-&gt;&gt;LaravelAPI: PUT /admin/users/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update pengguna\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Pengguna diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Pengguna Updated\nend\n\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WCbGFQ31zg-HS7D2Zsht-1">
