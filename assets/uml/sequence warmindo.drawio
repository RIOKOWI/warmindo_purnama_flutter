    <diagram id="On1kofiOVr0wvJwK92PP" name="kelola profile">
        <mxGraphModel dx="953" dy="565" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor User\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nUser-&gt;&gt;FlutterUI: Buka Halaman Profile\nFlutterUI-&gt;&gt;LaravelAPI: GET /profile (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil data user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Data user\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;User: Tampilkan Data Profile\n\nalt Edit Profile\n    User-&gt;&gt;FlutterUI: Ubah Data Profile\n    User-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /profile\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update data user\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Data diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;User: Tampilkan Data Updated\nend\n\nalt Ganti Password\n    User-&gt;&gt;FlutterUI: Klik Ganti Password\n    User-&gt;&gt;FlutterUI: Input Password Lama &amp; Baru\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /profile/password\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Validasi &amp; update password\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Password diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;User: Tampilkan Password Berhasil Diubah\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dPwqJsbvKDwwpQ6Wjy4T-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
