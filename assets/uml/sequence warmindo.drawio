        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Customer\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nCustomer-&gt;&gt;FlutterUI: Buka Halaman Pesanan\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil riwayat pesanan user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar pesanan\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: [orders]}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Customer: Tampilkan Riwayat Pesanan\n\nCustomer-&gt;&gt;FlutterUI: Pilih Pesanan\nCustomer-&gt;&gt;FlutterUI: Klik Detail Pesanan\n\nalt Pesanan Dine-In\n    Customer-&gt;&gt;FlutterUI: Pilih Meja\n    Customer-&gt;&gt;FlutterUI: Klik Konfirmasi\n    FlutterUI-&gt;&gt;LaravelAPI: POST /orders\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan pesanan dengan meja\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Pesanan tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: order}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan Detail Pesanan\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fTdxVCFO8e2Ibak0bTdj-1">
