      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Customer\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nCustomer-&gt;&gt;FlutterUI: Buka Halaman Riwayat Pesanan\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil riwayat pesanan user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar pesanan\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {orders}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Customer: Tampilkan Daftar Pesanan\n\nCustomer-&gt;&gt;FlutterUI: Pilih Pesanan\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders/{id}\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil detail pesanan\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Detail pesanan\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: order}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Customer: Tampilkan Detail Pesanan\n\nalt Status Pending - Bayar\n    Customer-&gt;&gt;FlutterUI: Klik Bayar\n    FlutterUI-&gt;&gt;Customer: Arahkan ke Halaman Pembayaran\nend\n\nalt Status Pending - Batalkan\n    Customer-&gt;&gt;FlutterUI: Klik Batalkan Pesanan\n    FlutterUI-&gt;&gt;Customer: Tampilkan Konfirmasi\n    Customer-&gt;&gt;FlutterUI: Konfirmasi Batal\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /orders/{id}/cancel\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update status pesanan (cancelled)\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Pesanan dibatalkan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: order}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan Pesanan Dibatalkan\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QX4fbH6XG5AcS1RyJaJN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
