  <diagram id="IzuuVdQdIif1jTu5JLNA" name="laporan penjualan">
    <mxGraphModel dx="860" dy="479" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Admin\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nAdmin-&gt;&gt;FlutterUI: Buka Halaman Laporan Penjualan\nFlutterUI--&gt;&gt;Admin: Tampilkan Filter Periode\n\nAdmin-&gt;&gt;FlutterUI: Pilih Periode (Hari/Minggu/Bulan/Kustom)\nAdmin-&gt;&gt;FlutterUI: Klik Lihat Laporan\n\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders?period={period}\nactivate LaravelAPI\n\nalt Custom Period\n    FlutterUI-&gt;&gt;LaravelAPI: GET /orders?period=custom&amp;start_date=X&amp;end_date=Y\nend\n\nLaravelAPI-&gt;&gt;Database: Query pesanan berdasarkan periode\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar pesanan\ndeactivate Database\n\nLaravelAPI-&gt;&gt;Database: Hitung total revenue &amp; statistik\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Analytics data\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {orders, totalRevenue, counts}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Admin: Tampilkan Laporan Penjualan\nFlutterUI--&gt;&gt;Admin: Tampilkan Total Revenue\nFlutterUI--&gt;&gt;Admin: Tampilkan Statistik (Pending/Completed/Cancelled)\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Zfs9Om_tJqy8NFCR_bJJ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
