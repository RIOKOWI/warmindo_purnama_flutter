                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor User\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nUser-&gt;&gt;FlutterUI: Buka Halaman Riwayat Pesanan\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil riwayat pesanan user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar pesanan\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {orders}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;User: Tampilkan Daftar Pesanan\n\nUser-&gt;&gt;FlutterUI: Pilih Pesanan\nFlutterUI-&gt;&gt;LaravelAPI: GET /orders/{id}\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil detail pesanan\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Detail pesanan\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: order}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;User: Tampilkan Detail Pesanan\n\nalt Status Pending - Bayar\n    User-&gt;&gt;FlutterUI: Klik Bayar\n    FlutterUI-&gt;&gt;User: Arahkan ke Halaman Pembayaran\nend\n\nalt Status Pending - Batalkan\n    User-&gt;&gt;FlutterUI: Klik Batalkan Pesanan\n    FlutterUI-&gt;&gt;User: Tampilkan Konfirmasi\n    User-&gt;&gt;FlutterUI: Konfirmasi Batal\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /orders/{id}/cancel\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update status pesanan (cancelled)\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Pesanan dibatalkan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: order}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;User: Tampilkan Pesanan Dibatalkan\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QX4fbH6XG5AcS1RyJaJN-1">
