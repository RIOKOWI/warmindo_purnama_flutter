        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Admin\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nAdmin-&gt;&gt;FlutterUI: Buka Halaman Kelola Kategori\nFlutterUI-&gt;&gt;LaravelAPI: GET /categories (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil semua kategori\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar kategori\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: [categories]}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Admin: Tampilkan Daftar Kategori\n\nalt Tambah Kategori\n    Admin-&gt;&gt;FlutterUI: Klik Tambah Kategori\n    Admin-&gt;&gt;FlutterUI: Input Nama Kategori\n    Admin-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: POST /admin/categories\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan kategori baru\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Kategori tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: category}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Kategori Ditambahkan\nend\n\nalt Edit Kategori\n    Admin-&gt;&gt;FlutterUI: Pilih Kategori\n    Admin-&gt;&gt;FlutterUI: Ubah Nama Kategori\n    Admin-&gt;&gt;FlutterUI: Klik Update\n\n    FlutterUI-&gt;&gt;LaravelAPI: PUT /admin/categories/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update kategori\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Kategori diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: category}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Kategori Updated\nend\n\nalt Hapus Kategori\n    Admin-&gt;&gt;FlutterUI: Pilih Kategori\n    Admin-&gt;&gt;FlutterUI: Klik Hapus\n\n    FlutterUI-&gt;&gt;LaravelAPI: DELETE /admin/categories/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Hapus kategori\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Kategori dihapus\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Kategori Dihapus\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8m3HB-jZRAeaKQIwpLsk-1">
