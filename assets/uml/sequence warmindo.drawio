    <diagram id="XnrnD3HpoC7I7oXFlwux" name="pembayaran">
        <mxGraphModel dx="736" dy="436" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor User\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nUser-&gt;&gt;FlutterUI: Buka Halaman Pembayaran\n\nUser-&gt;&gt;FlutterUI: Pilih Metode Pembayaran\nUser-&gt;&gt;FlutterUI: Klik Bayar\n\nFlutterUI-&gt;&gt;LaravelAPI: POST /orders/{id}/payment\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Buat record pembayaran\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Pembayaran tersimpan (status: pending)\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {payment}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;User: Tampilkan Detail Pembayaran\nFlutterUI--&gt;&gt;User: Tampilkan QR Code / Nomor VA\n\nalt Pembayaran QRIS\n    User-&gt;&gt;User: Scan QR dengan aplikasi bank\n    User-&gt;&gt;User: Konfirmasi pembayaran\n    Note over LaravelAPI: Pakasir/Gateway menangani konfirmasi\nend\n\nalt Pembayaran VA\n    User-&gt;&gt;User: Salin nomor VA\n    User-&gt;&gt;User: Bayar via ATM/Mobile Banking\n    Note over LaravelAPI: Pakasir/Gateway menangani konfirmasi\nend\n\nNote over User,LaravelAPI: Sistem menerima notifikasi dari payment gateway\n\nLaravelAPI-&gt;&gt;Database: Update status pembayaran (completed)\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Status updated\ndeactivate Database\n\nLaravelAPI-&gt;&gt;Database: Update status pesanan (paid)\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Pesanan updated\ndeactivate Database\n\nFlutterUI--&gt;&gt;User: Tampilkan Konfirmasi Berhasil\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Z1y3EctSLbpFklueoKqf-1">
