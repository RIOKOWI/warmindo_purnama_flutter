<mxfile host="app.diagrams.net" pages="18">
  <diagram id="6J5AchdAti3ZoM-GcNKH" name="kelola keranjang">
    <mxGraphModel dx="1229" dy="684" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Customer\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nCustomer-&gt;&gt;FlutterUI: Buka Halaman Keranjang\nFlutterUI-&gt;&gt;LaravelAPI: GET /cart (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil data keranjang user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Data keranjang\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: {items}}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Customer: Tampilkan Daftar Item\n\nalt Tambah Item\n    Customer-&gt;&gt;FlutterUI: Pilih produk &amp; jumlah\n    Customer-&gt;&gt;FlutterUI: Klik Tambah\n    FlutterUI-&gt;&gt;LaravelAPI: POST /cart\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan item ke keranjang\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Item tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: cartItem}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan item ditambahkan\nend\n\nalt Update Quantity\n    Customer-&gt;&gt;FlutterUI: Ubah jumlah item\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /cart/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update quantity\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Quantity diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: cartItem}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan quantity terbaru\nend\n\nalt Hapus Item\n    Customer-&gt;&gt;FlutterUI: Klik Hapus Item\n    FlutterUI-&gt;&gt;LaravelAPI: DELETE /cart/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Hapus item dari keranjang\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Item dihapus\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan item dihapus\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tbUp1wGaY-L2rIT4mwQh-1">
