  <diagram id="W9lJpGQPyd0DmcX0EVL1" name="ubah status meja">
    <mxGraphModel dx="860" dy="479" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Kasir\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nKasir-&gt;&gt;FlutterUI: Buka Halaman Status Meja\nFlutterUI-&gt;&gt;LaravelAPI: GET /tables (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil semua meja\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar meja dengan status\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: [tables]}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Kasir: Tampilkan Daftar Meja\nFlutterUI--&gt;&gt;Kasir: Tampilkan Status Setiap Meja (Available/Occupied)\n\nalt Ubah ke Occupied\n    Kasir-&gt;&gt;FlutterUI: Pilih Meja Available\n    Kasir-&gt;&gt;FlutterUI: Klik Ubah ke Occupied\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /tables/{id}/status\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update status meja\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Status meja updated\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: table}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Kasir: Tampilkan Meja Sekarang Occupied\nend\n\nalt Ubah ke Available\n    Kasir-&gt;&gt;FlutterUI: Pilih Meja Occupied\n    Kasir-&gt;&gt;FlutterUI: Klik Ubah ke Available\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /tables/{id}/status\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update status meja\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Status meja updated\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: table}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Kasir: Tampilkan Meja Sekarang Available\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_7cBGeYMCvkEiCNFN5nW-1">
