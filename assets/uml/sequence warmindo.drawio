  <diagram id="G8bhMF75Tk6WGcTkkc-_" name="kelola produk">
    <mxGraphModel dx="860" dy="479" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Admin\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nAdmin-&gt;&gt;FlutterUI: Buka Halaman Kelola Produk\nFlutterUI-&gt;&gt;LaravelAPI: GET /products (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil semua produk\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar produk\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: [products]}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Admin: Tampilkan Daftar Produk\n\nalt Tambah Produk\n    Admin-&gt;&gt;FlutterUI: Klik Tambah Produk\n    Admin-&gt;&gt;FlutterUI: Input data produk baru\n    Admin-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: POST /admin/products\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan produk baru\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Produk tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: product}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Produk Ditambahkan\nend\n\nalt Edit Produk\n    Admin-&gt;&gt;FlutterUI: Pilih Produk\n    Admin-&gt;&gt;FlutterUI: Ubah Data Produk\n    Admin-&gt;&gt;FlutterUI: Klik Update\n\n    FlutterUI-&gt;&gt;LaravelAPI: PUT /admin/products/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update produk\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Produk diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: product}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Produk Updated\nend\n\nalt Hapus Produk\n    Admin-&gt;&gt;FlutterUI: Pilih Produk\n    Admin-&gt;&gt;FlutterUI: Klik Hapus\n\n    FlutterUI-&gt;&gt;LaravelAPI: DELETE /admin/products/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Hapus produk\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Produk dihapus\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Produk Dihapus\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="soM40rv-kuymyp8bonb4-1">
