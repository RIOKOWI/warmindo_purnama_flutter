      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Admin\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nAdmin-&gt;&gt;FlutterUI: Buka Halaman Kelola Meja\nFlutterUI-&gt;&gt;LaravelAPI: GET /tables (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil semua meja\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Daftar meja\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: [tables]}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Admin: Tampilkan Daftar Meja\n\nalt Tambah Meja\n    Admin-&gt;&gt;FlutterUI: Klik Tambah Meja\n    Admin-&gt;&gt;FlutterUI: Input Nomor Meja\n    Admin-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: POST /admin/tables\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Simpan meja baru\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Meja tersimpan\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: table}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Meja Ditambahkan\nend\n\nalt Edit Meja\n    Admin-&gt;&gt;FlutterUI: Pilih Meja\n    Admin-&gt;&gt;FlutterUI: Ubah Data Meja\n    Admin-&gt;&gt;FlutterUI: Klik Update\n\n    FlutterUI-&gt;&gt;LaravelAPI: PUT /admin/tables/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update meja\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Meja diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: table}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Meja Updated\nend\n\nalt Hapus Meja\n    Admin-&gt;&gt;FlutterUI: Pilih Meja\n    Admin-&gt;&gt;FlutterUI: Klik Hapus\n\n    FlutterUI-&gt;&gt;LaravelAPI: DELETE /admin/tables/{id}\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Hapus meja\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Meja dihapus\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Admin: Tampilkan Meja Dihapus\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wKsgoxxgIbbpAG3aqSCG-1">
