        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\nactor Customer\nparticipant FlutterUI as Flutter UI\nparticipant LaravelAPI as Laravel API\nparticipant Database\n\nCustomer-&gt;&gt;FlutterUI: Buka Halaman Profile\nFlutterUI-&gt;&gt;LaravelAPI: GET /profile (Bearer Token)\nactivate LaravelAPI\n\nLaravelAPI-&gt;&gt;Database: Ambil data user\nactivate Database\nDatabase--&gt;&gt;LaravelAPI: Data user\ndeactivate Database\n\nLaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\ndeactivate LaravelAPI\n\nFlutterUI--&gt;&gt;Customer: Tampilkan Data Profile\n\nalt Edit Profile\n    Customer-&gt;&gt;FlutterUI: Ubah Data Profile\n    Customer-&gt;&gt;FlutterUI: Klik Simpan\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /profile\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Update data user\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Data diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan Data Updated\nend\n\nalt Ganti Password\n    Customer-&gt;&gt;FlutterUI: Klik Ganti Password\n    Customer-&gt;&gt;FlutterUI: Input Password Lama &amp; Baru\n\n    FlutterUI-&gt;&gt;LaravelAPI: PATCH /profile/password\n    activate LaravelAPI\n\n    LaravelAPI-&gt;&gt;Database: Validasi &amp; update password\n    activate Database\n    Database--&gt;&gt;LaravelAPI: Password diupdate\n    deactivate Database\n\n    LaravelAPI--&gt;&gt;FlutterUI: {success: true, data: user}\n    deactivate LaravelAPI\n\n    FlutterUI--&gt;&gt;Customer: Tampilkan Password Berhasil Diubah\nend\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dPwqJsbvKDwwpQ6Wjy4T-1">
