 updated_at\n    timestamp deleted_at\n}\n\nPAYMENTS {\n    bigint id PK\n    bigint order_id FK\n    string payment_method\n    decimal amount\n    decimal fee\n    decimal total_payment\n    text payment_number\n    string status\n    timestamp expired_at\n    timestamp completed_at\n    timestamp created_at\n    timestamp updated_at\n    timestamp deleted_at\n}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oQBjMz2frPVQwnyDLfus-1">
